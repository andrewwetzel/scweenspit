<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScweenSpit</RootNamespace>
    <AssemblyName>ScweenSpit</AssemblyName>
    <!-- Overridden by CI from the release tag; 0.0.0 locally so a dev build never looks current. -->
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- lets the project compile (not run) on Linux/macOS, so CI and dev boxes can typecheck it -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Framework-dependent single file: ~190 KB, against the shared .NET Desktop Runtime.
         Bundling the runtime instead costs 63 MB compressed, almost none of it ours - and 37 MB of
         that is WPF this app never touches, because Microsoft.WindowsDesktop.App ships WinForms and
         WPF as one indivisible pack. Trimming would fix that but NETSDK1175 forbids it outright for
         Windows Forms. ScweenSpit-Setup.exe installs the runtime for anyone who lacks it. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher is a separate, natively-compiled project. Without this the root project's
         **/*.cs glob would pull its sources - and its obj/ - straight into the app. -->
    <Compile Remove="launcher/**" />
    <None Remove="launcher/**" />
    <EmbeddedResource Remove="launcher/**" />
  </ItemGroup>

</Project>
